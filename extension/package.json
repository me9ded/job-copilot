{
  "name": "job-copilot-extension",
  "version": "0.1.0",
  "description": "Personal, local-first AI job search copilot for Chrome",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "E2E=1 wxt build && playwright test",
    "check": "npm run typecheck && npm test"
  },
  "type": "module",
  "dependencies": {
    "docx": "9.15.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "private": true
}
