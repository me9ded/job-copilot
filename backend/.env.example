# Copy to .env and fill in. Never commit .env.

# Shared secret the extension sends as "Authorization: Bearer <APP_TOKEN>".
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# SQLite by default. For PostgreSQL install the "postgres" extra and use e.g.
# postgresql+psycopg://jobcopilot:change-me@db:5432/jobcopilot
DATABASE_URL=sqlite:///./data/job_copilot.db

# Which model provider /v1/complete uses: mock | anthropic | openai | ollama
AI_PROVIDER=mock

# Anthropic (AI_PROVIDER=anthropic). Usage is billed by Anthropic to this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. The extension's tasks are short; low keeps cost down.
ANTHROPIC_EFFORT=low

# Any OpenAI-compatible chat-completions API (AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=

# Ollama on the server (AI_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Server-side limits (0 = unlimited).
DAILY_REQUEST_LIMIT=200
MONTHLY_TOKEN_LIMIT=2000000
MAX_INPUT_CHARS=60000
MAX_OUTPUT_TOKENS=4000
REQUEST_TIMEOUT_SECONDS=120
MAX_SYNC_BYTES=20000000

# Optional: USD per 1M tokens, copied from your provider's current pricing page,
# so the backend can report cost estimates. Leave 0 to report no cost.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
POSTGRES_PASSWORD=
